	id integer [ pk, increment, not null, note: 'ID unique de la saison' ]
	start_year smallint [ not null, note: 'Année de début de la saison' ]
	end_year smallint [ not null, note: 'Année de fin de la saison' ]

	indexes {
		(start_year, end_year) [ name: 'season_unique_0', unique ]
	}
}

