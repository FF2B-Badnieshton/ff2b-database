enum licence_status {
	brouillon
	"demandée"
	"en attente"
	"validée"
	suspendue
	"expirée"
	"annulée"
}

enum contact_origin {
	internet
	IA
	"téléphone"
	email
}

enum seance_status {
	"annulé"
	"reporté"
}

enum PAYMENTS_METHOD {
	carte_bancaire
	virement
	cheque
	especes
	pass_sport
	autre
}

enum PAYMENTS_STATUS {
	en_attente
	valide
	echoue
	rembourse
	annule
}

Table persons [headercolor: #f2463a] {
	ff2b_id uuid [ pk, not null, unique, note: 'Identifiant unique de la personne au sein de l''organisation' ]
	first_name text [ not null, note: 'Prénom de la personne' ]
	last_name text [ not null, note: 'Nom de famille de la personne' ]
	birthdate date [ not null, note: 'Date de naissance de la personne' ]
	phone_number text [ not null, note: 'Numéro de téléphone de la personne' ]
	email text [ not null, unique, note: 'Adresse email de la personne' ]
	status varchar(40) [ note: 'Status de la personne dans l''organisation' ]
	contact_origin contact_origin [ not null, note: 'L''origine du contact avec la personne' ]
	address varchar(255) [ note: 'Adresse postale de la personne ' ]
	municipality_id integer [ note: 'ID de la clée primaire de la commune de la personne' ]
	creation_date timestamptz [ note: 'Date de création de la personne dans la base de données' ]
}

Table person_role [headercolor: #175e7a] {
	id integer [ pk, increment, not null, note: 'ID unique du rôle de la personne' ]
	role_id smallint [ not null, note: 'ID du rôle' ]
	person_id uuid [ not null, note: 'ID de la personne' ]

	indexes {
		(role_id, person_id) [ name: 'person_role_unique_0', unique ]
	}
}

Table roles [headercolor: #175e7a] {
	id smallint [ pk, increment, not null, note: 'L''identifiant unique du role' ]
	code text [ not null, unique, note: 'Le code unique du rôle' ]
	label text [ not null, unique, note: 'Le texte affiché du rôle dans le système' ]
}

Table licenses [headercolor: #fa8282] {
	id uuid [ pk, not null, note: 'ID unique de la licence dans l''organisation' ]
	license_type integer [ not null, note: 'Le type de la licence.' ]
	person_id uuid [ not null, note: 'ID de la personne propriétaire de la licence' ]
	season integer [ not null, note: 'ID de la saison durant laquelle la licence est valide' ]
	request_date date [ not null, note: 'Date de demande de la licence' ]
	validation_date date [ note: 'Date de validation de la licence' ]
	beginning_date date [ note: 'Date de début de la licence' ]
	end_date date [ note: 'Date de fin de validité de la licence' ]
	license_status licence_status [ not null, note: 'Le statut de la licence' ]
	document_id uuid [ note: 'ID du document de certificat de la licence' ]
}

Table license_type [headercolor: #175e7a] {
	id integer [ pk, increment, not null, note: 'ID Unique du type de licence' ]
	license_code text [ not null, unique, note: 'Code du type de licence' ]
	license_label text [ not null, unique, note: 'Texte affiché du type de licence' ]

	indexes {
		(license_code, license_label) [ name: 'license_type_unique_0', unique ]
	}
}

