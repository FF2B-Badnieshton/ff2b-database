}

Table payments [headercolor: #175e7a] {
	id uuid [ pk, not null, note: 'ID du paiement' ]
	person_id uuid [ not null, note: 'UUID de la personne' ]
	license_id uuid [ not null, note: 'UUID de la licence' ]
	amount numeric(8,2) [ not null, note: 'Le montant du paiement' ]
	currency varchar(3) [ not null ]
	payment_method PAYMENTS_METHOD [ not null, note: 'Méthode de paiement' ]
	payment_status PAYMENTS_STATUS [ not null, note: 'Statut du paiement' ]
	payment_date timestamptz [ not null, note: 'Date du paiement' ]
	transaction_reference text [ not null, unique, note: 'Référence de la transaction' ]
	invoice_document uuid [ note: 'UUID du document de facture' ]
	notes text [ note: 'Notes sur le paiement' ]
	created_at timestamptz [ not null, note: 'Date de création du paiement' ]
	updated_at timestamptz [ not null, note: 'Date de mise à jour du paiement' ]
}

Table payments_history [headercolor: #175e7a] {
	id integer [ pk, increment, not null, note: 'ID de l''historique' ]
	payment_id uuid [ not null, note: 'ID du paiement' ]
	previous_status PAYMENTS_STATUS [ not null, note: 'Statut précédent' ]
	new_status PAYMENTS_STATUS [ not null, note: 'Nouveau statut' ]
	changed_by uuid [ note: 'UUID de la personne qui à changé le statut' ]
	changed_at timestamptz [ not null, note: 'Timestamp du moment du changement' ]
	reason text [ note: 'Raison du changement' ]
}

Table users_status [headercolor: #175e7a] {
	id integer [ pk, increment, not null, note: 'ID unique du statut de l''utilisateur' ]
	code text [ not null, unique, note: 'Code unique du statut de l''utilisateur' ]
	label text [ not null, unique, note: 'Label unique du statut de l''utilisateur' ]

	indexes {
		(code, label) [ name: 'users_status_unique_0', unique ]
	}
}

